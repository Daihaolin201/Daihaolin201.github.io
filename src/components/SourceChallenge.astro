---
import { PROBE_LIMIT } from '../lib/sourceSearch';
interface Props { lang: 'en' | 'zh' }
const { lang } = Astro.props;
const zh = lang === 'zh';
---
<div class="challenge" data-probe-challenge data-lang={lang}>
  <div class="field">
    <div class="field-head"><h2>{zh ? '采样地图' : 'Sampling field'}</h2><span class="phase" data-phase></span></div>
    <p class="lead" data-instruction></p>
    <svg class="chart" data-probe-map viewBox="0 0 800 496" tabindex="0" role="group" aria-label={zh ? '采样地图。使用方向键移动光标，按回车执行。' : 'Sampling map. Move with the arrow keys and press Enter to act.'} aria-describedby="probe-key-help">
      <defs>
        <pattern id="probe-grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" fill="none" stroke="#243c49" stroke-width="1"/></pattern>
        <pattern id="probe-grid-major" width="160" height="160" patternUnits="userSpaceOnUse"><path d="M160 0H0V160" fill="none" stroke="#385765" stroke-width="1"/><path d="M0 4V0H4 M156 0h4v4 M0 156v4h4" fill="none" stroke="#617b82"/></pattern>
        <linearGradient id="probe-surface" x2="1" y2="1" gradientUnits="objectBoundingBox"><stop stop-color="#132b32"/><stop offset="1" stop-color="#091721"/></linearGradient>
      </defs>
      <rect width="800" height="496" fill="url(#probe-surface)"/><rect width="800" height="496" fill="url(#probe-grid)"/><rect width="800" height="496" fill="url(#probe-grid-major)"/>
      <g fill="#8ba6b0" font-family="ui-monospace,monospace" font-size="14" aria-hidden="true"><text x="13" y="22">0, 0</text><text x="787" y="482" text-anchor="end">100, 62</text></g>
      <g data-probe-lines></g><g data-probe-pins></g><g data-reveal-marks></g>
      <g data-probe-cursor fill="none" stroke="#f7d08d" stroke-width="2"><path d="M-24 -14v-10h10 M14 -24h10v10 M24 14v10H14 M-14 24h-10V14"/><path d="M-9 0H9M0 -9V9" opacity=".85"/></g>
    </svg>
    <div class="under-map"><span class="coord" data-cursor-readout></span><span id="probe-key-help">{zh ? '方向键移动，回车采样或标记' : 'Arrow keys to move, Enter to sample or mark'}</span></div>
    <div class="reveal-key" data-reveal-key hidden><span><i class="human"></i>{zh ? '你的猜测' : 'Your guess'}</span><span><i class="robot"></i>{zh ? '机器人估计' : 'Robot estimate'}</span><span><i class="source"></i>{zh ? '真实位置' : 'True source'}</span></div>
  </div>
  <div class="console">
    <div class="gauge">
      <svg class="probe-icon" aria-hidden="true" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M30 33 43 20m-8 8 4 4m-13-3 9 9-17 17-9-9z" stroke-width="2.8"/><path d="m18 43 4 4m-1-7 4 4"/><circle cx="44" cy="19" r="3" fill="currentColor" stroke="none"/><path d="M42 11a10 10 0 0 1 10 10m-9-18a17 17 0 0 1 16 17" stroke-width="2"/></svg>
      <div><span class="gauge-label">{zh ? '信号强度' : 'Signal strength'}</span><strong data-level>—</strong><small> / 100</small></div>
      <div class="meter" aria-hidden="true"><span data-meter></span></div>
    </div>
    <div class="budget"><span>{zh ? '已用测量次数' : 'Readings used'}</span><b data-probe-count>0 / {PROBE_LIMIT}</b></div>
    <div class="probe-actions">
      <button class="primary" type="button" data-sample>{zh ? '在光标处采样' : 'Sample at cursor'}</button>
      <button type="button" data-mark disabled>{zh ? '开始猜位置' : 'Make a guess'}</button>
      <button class="primary" type="button" data-submit hidden>{zh ? '提交并揭晓' : 'Reveal the source'}</button>
      <button type="button" data-resume hidden>{zh ? '继续采样' : 'Keep sampling'}</button>
    </div>
    <section class="log" aria-labelledby="probe-log-title"><h3 id="probe-log-title">{zh ? '读数记录' : 'Probe readings'}</h3><p class="empty" data-empty>{zh ? '点击地图读取第一个读数。' : 'Tap the field to take the first reading.'}</p><ol data-probe-log></ol></section>
  </div>
  <section class="outcome" data-outcome hidden aria-live="polite">
    <div><h3 data-winner tabindex="-1"></h3><p data-truth></p></div>
    <dl><div><dt>{zh ? '你的定位误差' : 'Your error'}</dt><dd data-human-error></dd><dd class="estimate" data-human-point></dd></div><div><dt>{zh ? '机器人误差' : 'Robot error'}</dt><dd data-robot-error></dd><dd class="estimate" data-robot-point></dd></div></dl>
    <div class="again"><button type="button" data-replay>{zh ? '重玩同一题' : 'Replay this field'}</button><button class="primary" type="button" data-new>{zh ? '换一道题' : 'New field'}</button></div>
  </section>
  <span class="sr" data-announce aria-live="polite" aria-atomic="true"></span>
  <details class="rules"><summary>{zh ? '规则与信息' : 'Rules and information'}</summary><p>{zh ? '地图宽 100、高 62 个单位。读数越高，通常离源越近，但读数会有噪声。可重复测量同一地点，也可提前提交。机器人只获得玩家采样的位置和屏幕显示的读数，依据相同的信号衰减模型估计位置。双方各猜一次，以到真实位置的直线距离评分。' : 'The field is 100 units wide and 62 high. Stronger readings usually mean a closer source, with noise on every probe. Repeat probes and early guesses are allowed. The robot receives exactly the coordinates and readings shown on screen and fits the signal’s distance curve. Each player makes one guess. The shorter straight-line distance to the source wins.'}</p><p>{zh ? '模型中的预期强度为 100 / (1 + (距离 / 28)²)，噪声标准差约为 5.5。' : 'Expected strength is 100 / (1 + (distance / 28)²), with noise of about 5.5 points standard deviation.'}</p></details>
</div>
<style>
  .challenge { --gold: #f4d08e; display: grid; grid-template-columns: minmax(0, 1.9fr) minmax(260px, 1fr); gap: 1rem; color: var(--text); align-items: start; }
  .challenge [hidden] { display: none !important; }
  .field, .console, .outcome, .rules { border-radius: 16px; min-width: 0; padding: clamp(.95rem, 2vw, 1.4rem); box-shadow: var(--panel-shadow); }
  /* the sampling field and the result board are screens: dark in both themes */
  .field, .outcome { color: #eef6f7; border: 1px solid #344c58; background: #101f2c; }
  .console, .rules { border: 1px solid var(--edge); background: var(--panel); }
  h2, h3, p, dl, ol, dd { margin: 0; }
  .field-head, .under-map, .budget, .again, .reveal-key { display: flex; align-items: center; justify-content: space-between; gap: .6rem; }
  .challenge h2 { font: 600 1.2rem/1.3 var(--serif); }
  .challenge h3 { font-size: 1rem; }
  .phase { font-size: .8rem; color: var(--gold); border: 1px solid #6c5a36; background: #2c2a24; border-radius: 999px; padding: .28rem .65rem; }
  .lead, .outcome p { color: #b2c2cb; font-size: .9rem; line-height: 1.6; }
  .rules p, .empty { color: var(--muted); font-size: .9rem; line-height: 1.65; }
  .lead { margin: .5rem 0 .9rem; min-height: 2.7em; }
  .chart { display: block; width: 100%; border: 1px solid #41606b; border-radius: 10px; overflow: hidden; cursor: crosshair; touch-action: manipulation; }
  .chart:focus-visible, .field :focus-visible, .outcome :focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
  .console :focus-visible, .rules :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .under-map, .reveal-key { font-size: .8rem; color: #abc0c7; flex-wrap: wrap; margin-top: .7rem; }
  .coord, .gauge, .budget b, dd, .log ol { font-variant-numeric: tabular-nums; }
  .coord, .gauge strong, .budget b, .log ol { font-family: var(--mono); }
  .coord { color: var(--gold); }
  .reveal-key { justify-content: flex-start; gap: 1rem; }
  .reveal-key span { display: inline-flex; align-items: center; gap: .4rem; }
  .reveal-key i { display: inline-block; width: .65rem; height: .65rem; border: 2px solid; }
  .human { border-color: #ffbb83 !important; transform: rotate(45deg); }
  .robot { border-color: #b0b9ff !important; }
  .source { border-radius: 50%; border-color: #a3f1bc !important; }
  /* the signal gauge reads like a small instrument display in both themes */
  .gauge { display: grid; grid-template-columns: 46px 1fr; align-items: center; column-gap: .8rem; color: #eef6f7; background: linear-gradient(110deg, #142f34, #101f2c); border: 1px solid #3b5b5d; border-radius: 12px; padding: .75rem 1rem; }
  .probe-icon { width: 46px; color: #8bddd2; }
  .gauge-label { display: block; font-size: .82rem; line-height: 1.2; color: #b4d3d1; }
  .gauge strong { font-size: 2.45rem; line-height: 1.15; color: #b8eee1; }
  .gauge small { color: #a0b5b6; font-size: .78rem; }
  .meter { grid-column: 1/-1; height: .37rem; margin-top: .35rem; border-radius: .17rem; background: #2c474d; overflow: hidden; }
  .meter span { display: block; height: 100%; width: 0; background: #9cdfce; }
  .budget { font-size: .9rem; color: var(--muted); margin: 1rem 0 .75rem; }
  .budget b { color: var(--warm); }
  .probe-actions, .again { display: flex; flex-wrap: wrap; gap: .5rem; }
  .challenge button { cursor: pointer; line-height: 1.3; font-size: .9rem; font-weight: 600; min-height: 44px; padding: .55rem .85rem; border: 1px solid var(--edge-strong); border-radius: 9px; background: var(--sunk); color: var(--text); }
  .outcome button { border-color: #48606a; background: #1c3241; color: #e4eef1; }
  .challenge button.primary { background: var(--gold); border-color: var(--gold); color: #2a241c; }
  .challenge button:not(:disabled):hover { filter: brightness(1.06); border-color: var(--accent); }
  .challenge button.primary:not(:disabled):hover { border-color: var(--gold); }
  .challenge button:disabled { opacity: .45; cursor: default; }
  .log { margin-top: 1rem; padding-top: .8rem; border-top: 1px solid var(--edge); }
  .empty { margin-top: .45rem; }
  .log ol { padding-left: 0; list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: .3rem; font-size: .76rem; color: var(--muted); }
  .log ol:not(:empty) { margin-top: .5rem; }
  .log :global(li) { padding: .3rem .4rem; background: var(--sunk); border: 1px solid var(--edge); border-radius: 5px; }
  .log :global(li b) { color: var(--warm); }
  .outcome, .rules { grid-column: 1/-1; }
  .outcome { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; border-color: #698268; background: #16262b; }
  .outcome p { margin-top: .25rem; }
  .outcome dl { display: flex; gap: 1.4rem; }
  .outcome dt { color: #b4c4c8; font-size: .82rem; }
  .outcome dd { font-size: 1.2rem; font-weight: 700; }
  .outcome dl > div:first-child dd { color: #ffbb83; }
  .outcome dl > div:last-child dd { color: #b0b9ff; }
  .outcome .estimate { font-size: .78rem; font-weight: 400; margin-top: .2rem; }
  .again { justify-content: flex-start; }
  .rules { padding-block: 0; }
  .rules summary { cursor: pointer; font-size: .92rem; padding: .7rem 0; width: fit-content; }
  .rules p { margin: 0 0 .8rem; max-width: 80ch; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (max-width: 760px) {
    .challenge { grid-template-columns: 1fr; }
    .lead { min-height: 0; }
    .under-map { font-size: .75rem; }
    .gauge { grid-template-columns: 40px 1fr; }
    .console { padding: 1rem; }
    .outcome { align-items: flex-start; }
    .outcome > div:first-child { width: 100%; }
  }
</style>
