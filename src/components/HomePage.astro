---
import type english from '../data/en.json';
import CitePublication from './CitePublication.astro';
import ProjectShowcase from './ProjectShowcase.astro';
import { entryLinks, publicEmail } from '../data/publicLinks';
import { siteTools, toolUrl } from '../data/siteTools';
import { role, siteName, personSchema, jsonLd } from '../data/profile';

interface Props { page: typeof english }
const { page } = Astro.props;
const alternate = page.languageLink;
const lang = page.lang === 'en' ? 'en' : 'zh';
const mailto = 'mailto:' + publicEmail;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL('/images/dl-share-v1.jpg', Astro.site);
const zh = lang === 'zh';
const tx = (en: string, cn: string) => (zh ? cn : en);
const sec = (id: string) => page.sections.find(s => s.id === id)!;
type Entry = { id: string; title: string; date?: string; organisation?: string; authors?: string; citation?: string; status?: string; bullets?: string[] };
const entries = (id: string) => sec(id).entries as Entry[];
const self = (name: string) => name === 'D. Li' || name === 'Donglin Li';
const linkOf = (id: string) => entryLinks[id]?.href;
const scholar = page.quickLinks.find(l => /scholar|谷歌学术/i.test(l.label));
const shareImageAlt = page.lang === 'en'
  ? 'DL monogram beside Donglin Li’s name and research area, Control, Robotics & AI.'
  : 'DL 字标、李栋林的英文姓名及研究方向：控制、机器人与人工智能。';
const cvUrl = zh ? '/zh/cv/' : '/cv/';
const abs = (path: string) => new URL(path, Astro.site).href;
const structured = jsonLd({
  '@type': 'ProfilePage', url: pageUrl.href, inLanguage: page.lang, name: page.title,
  mainEntity: personSchema(Astro.site, lang, page.contact.profiles),
});
// The name splits into the name proper and the nickname in brackets, so a narrow screen breaks between them.
const nameMatch = page.name.match(/^(.*?)\s*([（(].*[)）])$/);
---
<!doctype html>
<html lang={page.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={page.intro} />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>try{var t=localStorage.getItem("dl-theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t}catch(e){}</script>
    <title>{page.title}</title>
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/dl-touch.png" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.intro} />
    <meta property="og:image" content={shareImage.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage.href} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    <meta property="og:site_name" content={siteName[lang]} />
    <meta property="og:locale" content={zh ? 'zh_CN' : 'en_GB'} />
    <meta property="og:locale:alternate" content={zh ? 'en_GB' : 'zh_CN'} />
    <meta name="theme-color" content="#060b18" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#eef3fb" media="(prefers-color-scheme: light)" />
    <link rel="alternate" hreflang="en" href={abs('/')} />
    <link rel="alternate" hreflang="zh-CN" href={abs('/zh/')} />
    <link rel="alternate" hreflang="x-default" href={abs('/')} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={structured} />
  </head>
  <body>
    <a class="skip-link" href="#about">{page.skip}</a>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <div class="aurora" aria-hidden="true"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
    <canvas id="agents" aria-hidden="true"></canvas>
    <div class="grid" aria-hidden="true"></div>
    <div class="spotlight" aria-hidden="true"></div>
    <nav class="top-nav" aria-label={page.navLabel}>
      <div class="bar glass">
        <a class="brand" href="#about">{page.name}</a>
        <button type="button" class="menu-toggle" aria-controls="menu" aria-expanded="false" hidden>{tx('Sections', '目录')} <span aria-hidden="true">⌄</span></button>
        <div class="menu" id="menu">
          {page.menu.map(link => <a href={link.href}>{link.label}</a>)}
        </div>
        <button type="button" class="theme-btn" data-theme-toggle aria-label={tx('Switch between dark and light', '切换深色和浅色')} data-label-dark={tx('Dark', '深色')} data-label-light={tx('Light', '浅色')}><svg class="i-moon" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M15.5 12.8A6.5 6.5 0 0 1 7.2 4.5a6.5 6.5 0 1 0 8.3 8.3Z" fill="currentColor"/></svg><svg class="i-sun" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><circle cx="10" cy="10" r="3.6" fill="currentColor"/><path d="M10 1.8v2.4M10 15.8v2.4M1.8 10h2.4M15.8 10h2.4M4.2 4.2l1.7 1.7M14.1 14.1l1.7 1.7M4.2 15.8l1.7-1.7M14.1 5.9l1.7-1.7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
        <a class="lang-btn" id="home-language" href={alternate.href} hreflang={alternate.lang} lang={alternate.lang}>{alternate.label}</a>
      </div>
    </nav>
    <main>
      <header class="hero glass" id="about">
        <div class="hero-text">
          <div class="who">
            <img class="avatar" src="/images/avatar-256.jpg" alt="" width="128" height="128" fetchpriority="high" />
            <div>
              <h1>{nameMatch ? <>{nameMatch[1]}<span class="nick">{nameMatch[2]}</span></> : page.name}</h1>
              <p class="role">{role[lang]}</p>
            </div>
          </div>
          <p class="lead">{page.headline}</p>
          <p class="intro">{page.lead ?? page.intro}</p>
          <div class="actions">
            <a class="btn primary" href="#projects">{tx('See the projects', '看项目')}</a>
            <a class="btn" href={cvUrl}>{tx('CV', '简历')}</a>
            {page.actions.map(link => <a class="btn" href={link.href}>{link.label}</a>)}
          </div>
          <ul class="profiles">
            <li><a href={mailto}>{publicEmail}</a></li>
            {page.quickLinks.map(link => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
        <aside class="try glass-inner">
          <h2>{tx('Try it', '动手试试')}</h2>
          <ul>
            <li><a href={toolUrl('lab', lang)}><b>{siteTools.lab[lang]}</b><span>{tx('Place a signal source and compare two robot search strategies.', '设定信号源，比较两种机器人搜索策略。')}</span></a></li>
            <li><a href={toolUrl('pid', lang)}><b>{siteTools.pid[lang]}</b><span>{tx('Tune a PID controller to stop the cart on target.', '整定 PID，使小车准确停在目标点。')}</span></a></li>
            <li><a href="#projects"><b>{tx('Project games', '项目小游戏')}</b><span>{tx('Eight games: trolley pushing, delivery, lane closure and more.', '推车、配送、封道等八个小游戏。')}</span></a></li>
          </ul>
        </aside>
      </header>

      <section class="sec glass" id="updates">
        <h2>{sec('updates').heading}</h2>
        <ol class="rows news">
          {entries('updates').map(e => (
            <li id={e.id}><time>{e.date}</time><div><h3>{linkOf(e.id) ? <a href={linkOf(e.id)}>{e.title}</a> : e.title}</h3>{e.bullets?.map(b => <p>{b}</p>)}</div></li>
          ))}
        </ol>
      </section>

      <section class="sec glass" id="research">
        <h2>{sec('research').heading}</h2>
        <div>
          {entries('research').map(e => (
            <article class="research" id={e.id}>
              <h3>{e.title}</h3>
              <p class="org">{e.organisation}<span class="when">{e.date}</span></p>
              {e.bullets?.map(b => <p>{b}</p>)}
              <p class="try-links"><a class="btn" href={toolUrl('lab', lang) + '#challenge'}>{tx('Eight-reading challenge', '八次测量定位挑战')}</a> <a class="btn" href={toolUrl('pid', lang)}>{tx('PID tuning challenge', 'PID 调参挑战')}</a></p>
            </article>
          ))}
        </div>
      </section>

      <section class="sec glass" id="publications">
        <h2>{sec('publications').heading}</h2>
        <div>
        <ol class="pubs">
          {entries('publications').map(e => (
            <li id={e.id}>
              <h3>{linkOf(e.id) ? <a href={linkOf(e.id)}>{e.title}</a> : e.title}</h3>
              <p class="authors">{e.authors?.split(', ').map((n, i) => <>{i > 0 && ', '}{self(n) ? <strong>{n}</strong> : n}</>)}</p>
              <p class="venue">{e.citation}</p>
              <p class="facts"><span class:list={['tag', { first: /first|第一/i.test(e.organisation ?? '') }]}>{e.organisation}</span>{e.status && <span class="state">{e.status}</span>}</p>
              <CitePublication id={e.id} lang={page.lang} paper={e} />
            </li>
          ))}
        </ol>
        <p class="more">{scholar && <a href={scholar.href}>{tx('All papers on Google Scholar', '在谷歌学术查看全部论文')}</a>}<a href="/publications.bib" download="donglin-li-publications.bib">{tx('Download all as BibTeX', '下载全部 BibTeX')}</a></p>
        </div>
      </section>

      <section class="sec wide glass" id="projects">
        <h2>{sec('projects').heading}</h2>
        <ProjectShowcase lang={lang} />
      </section>

      {(['employment', 'education', 'service'] as const).map(id => (
        <section class="sec glass" id={id}>
          <h2>{sec(id).heading}</h2>
          <ol class="rows">
            {entries(id).map(e => (
              <li id={e.id}><time>{e.date}</time><div><h3>{linkOf(e.id) ? <a href={linkOf(e.id)}>{e.title}</a> : e.title}</h3>{e.organisation && <p class="org">{e.organisation}</p>}{e.bullets?.map(b => <p>{b}</p>)}{e.id === 'phd-representative' && <p class="entry-link"><a class="btn" href={toolUrl('pgr', lang)}>{siteTools.pgr[lang]}</a></p>}</div></li>
            ))}
          </ol>
        </section>
      ))}

      <section class="sec glass" id="awards">
        <h2>{sec('awards').heading}</h2>
        <ol class="rows awards">
          {entries('awards').map(e => (
            <li id={e.id}><time>{e.date}</time><div><h3>{linkOf(e.id) ? <a href={linkOf(e.id)}>{e.title}</a> : e.title}</h3>{e.organisation && <p class="org">{e.organisation}</p>}</div></li>
          ))}
        </ol>
      </section>

      <section class="sec glass" id="skills">
        <h2>{sec('skills').heading}</h2>
        <dl class="skills">
          {entries('skills').map(e => <><dt id={e.id}>{e.title}</dt><dd>{e.bullets?.join(' ')}</dd></>)}
        </dl>
      </section>

      <section class="sec glass" id="contact">
        <h2>{page.contact.heading}</h2>
        <div class="contact">
          <p class="mail"><a href={mailto}>{publicEmail}</a><button type="button" class="copy-mail" hidden data-copy-email={publicEmail} data-done={tx('Copied', '已复制')}>{tx('Copy address', '复制地址')}</button><span class="copy-status" role="status" aria-live="polite"></span></p>
          <p class="contact-actions"><a class="btn" href="/donglin-li.vcf" download="Donglin-Li.vcf">{tx('Save contact (vCard)', '存入通讯录（vCard）')}</a><a class="btn" href={cvUrl}>{tx('CV', '简历')}</a></p>
          <ul class="profiles">
            <li><a href={toolUrl('message', lang)}>{siteTools.message[lang]}</a></li>
            <li><a href={toolUrl('hi', lang)}>{siteTools.hi[lang]}</a></li>
            {page.contact.profiles.map(link => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
      </section>
    </main>
    <footer>{page.name}<span>{page.updated}<a class="verify-link" href={zh ? '/zh/verify/' : '/verify/'}>{tx('Identity & Homonyms', '身份核验与同名区分')}</a></span></footer>
    <script>
      import '../lib/homeNavigation';
      import '../lib/theme';
      import '../lib/copyEmail';
    </script>
    <script is:inline src="/assets/effects.js"></script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #060b18; --bg2: #0a1226; --text: #eaf0ff; --muted: #a6b6d6; --faint: #7586aa;
    --accent: #22d3ee; --on-accent: #04121c; --violet: #a855f7; --sky: #38bdf8;
    --panel: rgba(16, 26, 51, .55); --panel-strong: rgba(13, 21, 43, .8); --edge: rgba(125, 178, 255, .16); --edge-strong: rgba(125, 178, 255, .3);
    --chip-bg: rgba(125, 178, 255, .07); --hover: rgba(125, 178, 255, .08); --selected: rgba(34, 211, 238, .12);
    --tint-violet: rgba(168, 85, 247, .2); --ink-violet: #dcc2ff; --tint-sky: rgba(56, 189, 248, .18); --ink-sky: #9adcff; --tint-teal: rgba(45, 212, 191, .18); --ink-teal: #7debd9;
    --shadow: 0 24px 60px rgba(2, 6, 18, .5); --aurora: .55; --grid-line: rgba(125, 178, 255, .05);
    --serif: Charter, "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, "Songti SC", "Noto Serif SC", STSong, serif;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    --mono: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    --sensor: var(--accent);
  }
  :root[data-theme="light"] {
    color-scheme: light;
    --bg: #eef3fb; --bg2: #e4ecf8; --text: #0f1c33; --muted: #46597a; --faint: #53658a;
    --accent: #0e7490; --on-accent: #ffffff; --violet: #7c3aed; --sky: #0284c7;
    --panel: rgba(255, 255, 255, .62); --panel-strong: rgba(255, 255, 255, .86); --edge: rgba(30, 64, 120, .12); --edge-strong: rgba(30, 64, 120, .24);
    --chip-bg: rgba(255, 255, 255, .7); --hover: rgba(14, 116, 144, .07); --selected: rgba(14, 116, 144, .12);
    --tint-violet: rgba(124, 58, 237, .12); --ink-violet: #5b21b6; --tint-sky: rgba(2, 132, 199, .12); --ink-sky: #075985; --tint-teal: rgba(13, 148, 136, .13); --ink-teal: #0f766e;
    --shadow: 0 18px 50px rgba(30, 60, 110, .14); --aurora: .32; --grid-line: rgba(30, 64, 120, .06);
  }
  @media (prefers-color-scheme: light) { :root:not([data-theme="dark"]) {
    color-scheme: light;
    --bg: #eef3fb; --bg2: #e4ecf8; --text: #0f1c33; --muted: #46597a; --faint: #53658a;
    --accent: #0e7490; --on-accent: #ffffff; --violet: #7c3aed; --sky: #0284c7;
    --panel: rgba(255, 255, 255, .62); --panel-strong: rgba(255, 255, 255, .86); --edge: rgba(30, 64, 120, .12); --edge-strong: rgba(30, 64, 120, .24);
    --chip-bg: rgba(255, 255, 255, .7); --hover: rgba(14, 116, 144, .07); --selected: rgba(14, 116, 144, .12);
    --tint-violet: rgba(124, 58, 237, .12); --ink-violet: #5b21b6; --tint-sky: rgba(2, 132, 199, .12); --ink-sky: #075985; --tint-teal: rgba(13, 148, 136, .13); --ink-teal: #0f766e;
    --shadow: 0 18px 50px rgba(30, 60, 110, .14); --aurora: .32; --grid-line: rgba(30, 64, 120, .06);
  } }
  :root[data-theme="light"] .spotlight { mix-blend-mode: multiply; opacity: .25; }
  :root[data-theme="light"] .glass::after { background: linear-gradient(180deg, rgba(255, 255, 255, .5), transparent 45%); }
  :lang(zh-CN) { --serif: "Songti SC", "Noto Serif SC", STSong, "Source Han Serif SC", serif; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .aurora span { animation: none !important; } }
  body { margin: 0; background: linear-gradient(180deg, var(--bg), var(--bg2)) fixed; color: var(--text); font: 16px/1.6 var(--sans); -webkit-font-smoothing: antialiased; min-height: 100vh; }
  a { color: var(--accent); text-underline-offset: .18em; text-decoration-thickness: 1px; }
  a:hover { color: var(--text); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
  .skip-link { position: absolute; left: 12px; top: -60px; z-index: 90; background: var(--text); color: var(--bg); padding: 8px 12px; }
  .skip-link:focus { top: 10px; }

  /* background: drifting aurora, faint grid, robots that follow the pointer, a soft spotlight */
  .aurora { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; filter: blur(70px); opacity: var(--aurora); }
  .aurora span { position: absolute; display: block; border-radius: 50%; will-change: transform; }
  .aurora .a1 { width: 48vw; height: 48vw; left: -8vw; top: -12vh; background: radial-gradient(circle, rgba(34,211,238,.55), transparent 66%); animation: drift1 24s ease-in-out infinite; }
  .aurora .a2 { width: 42vw; height: 42vw; right: -10vw; top: -6vh; background: radial-gradient(circle, rgba(168,85,247,.5), transparent 66%); animation: drift2 29s ease-in-out infinite; }
  .aurora .a3 { width: 40vw; height: 40vw; left: 32vw; top: 22vh; background: radial-gradient(circle, rgba(56,189,248,.4), transparent 66%); animation: drift3 33s ease-in-out infinite; }
  @keyframes drift1 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(9vw,7vh) scale(1.14); } }
  @keyframes drift2 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(-8vw,9vh) scale(1.1); } }
  @keyframes drift3 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(6vw,-7vh) scale(1.18); } }
  #agents { position: fixed; inset: 0; z-index: 1; width: 100vw; height: 100vh; pointer-events: none; }
  .grid { position: fixed; inset: 0; z-index: 0; pointer-events: none; background-image: linear-gradient(var(--grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--grid-line) 1px, transparent 1px); background-size: 48px 48px; -webkit-mask-image: radial-gradient(120% 90% at 50% 0%, #000 35%, transparent 78%); mask-image: radial-gradient(120% 90% at 50% 0%, #000 35%, transparent 78%); }
  .spotlight { position: fixed; inset: 0; z-index: 3; pointer-events: none; opacity: .55; mix-blend-mode: screen; background: radial-gradient(380px circle at var(--mx, 72%) var(--my, 14%), rgba(56, 189, 248, .14), transparent 62%); }
  .scroll-progress { position: fixed; top: 0; left: 0; height: 3px; width: 100%; transform: scaleX(0); transform-origin: 0 50%; z-index: 60; pointer-events: none; background: linear-gradient(90deg, var(--accent), var(--sky) 55%, var(--violet)); box-shadow: 0 0 16px rgba(34, 211, 238, .6); }

  /* liquid glass */
  .glass { position: relative; background: var(--panel); border: 1px solid var(--edge); border-radius: 22px; -webkit-backdrop-filter: blur(18px) saturate(150%); backdrop-filter: blur(18px) saturate(150%); box-shadow: var(--shadow), inset 0 1px 0 rgba(255, 255, 255, .06); }
  .glass::after { content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; background: linear-gradient(180deg, rgba(125, 178, 255, .08), transparent 40%); }
  .glass > * { position: relative; z-index: 1; }

  /* Glass refinements: a solid panel where the system asks for less transparency; a lighter blur on touch screens,
     where a large backdrop-filter costs the most. */
  @media (prefers-reduced-transparency: reduce) {
    .glass, .top-nav .bar { background: var(--bg2); -webkit-backdrop-filter: none; backdrop-filter: none; }
    .aurora, .spotlight { display: none; }
  }
  @media (hover: none), (pointer: coarse) {
    .glass { -webkit-backdrop-filter: blur(10px) saturate(140%); backdrop-filter: blur(10px) saturate(140%); }
    .aurora { filter: blur(48px); }
    .spotlight { display: none; }
  }

  /* theme switch */
  .theme-btn { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; border: 1px solid var(--edge-strong); background: var(--chip-bg); color: var(--text); cursor: pointer; }
  .theme-btn .i-sun { display: none; }
  :root[data-theme="light"] .theme-btn .i-sun { display: block; }
  :root[data-theme="light"] .theme-btn .i-moon { display: none; }
  @media (prefers-color-scheme: light) { :root:not([data-theme="dark"]) .theme-btn .i-sun { display: block; } :root:not([data-theme="dark"]) .theme-btn .i-moon { display: none; } }

  /* header */
  .top-nav { position: sticky; top: 0; z-index: 30; padding: .7rem 16px 0; }
  .top-nav .bar { max-width: 1180px; margin: 0 auto; padding: 0 14px 0 20px; min-height: 56px; display: flex; align-items: center; gap: 1.1rem; border-radius: 16px; background: var(--panel-strong); }
  .brand { font: 600 1.05rem/1 var(--serif); color: var(--text); text-decoration: none; margin-right: auto; white-space: nowrap; }
  .menu { display: flex; gap: 1rem; }
  .menu a { color: var(--muted); text-decoration: none; font-size: .9rem; padding: .3rem 0; white-space: nowrap; border-bottom: 2px solid transparent; }
  .menu a:hover, .menu a[aria-current="true"] { color: var(--text); border-bottom-color: var(--accent); }
  .lang-btn, .menu-toggle { display: inline-flex; align-items: center; gap: .35rem; min-height: 36px; padding: 0 .8rem; border: 1px solid var(--edge-strong); border-radius: 10px; background: var(--chip-bg); color: var(--text); font: 500 .85rem var(--sans); text-decoration: none; cursor: pointer; white-space: nowrap; }
  .menu-toggle, .menu-toggle[hidden] { display: none; }
  main { position: relative; z-index: 2; max-width: 1180px; margin: 0 auto; padding: 1rem 16px 0; display: grid; gap: 1rem; }
  main [id] { scroll-margin-top: var(--home-nav-clearance, 84px); }
  @media (max-width: 1100px) {
    .top-nav[data-disclosure] .menu-toggle { display: inline-flex; }
    .top-nav[data-disclosure] .menu { display: none; }
