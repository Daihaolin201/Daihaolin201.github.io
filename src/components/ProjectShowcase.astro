                    <rect x="44" y="64" width="24" height="22" rx="4" fill="#153c45" stroke="#7ce0d2" stroke-width="1.4" data-anim="blink" data-dur="1.5" data-on="1"/>
                    <rect x="134" y="36" width="24" height="22" rx="4" fill="#413218" stroke="#ffcc8e" stroke-width="1.4" data-anim="blink" data-dur="1.5" data-delay=".5" data-on="1"/>
                    <rect x="104" y="92" width="24" height="22" rx="4" fill="#153c45" stroke="#7ce0d2" stroke-width="1.4" data-anim="blink" data-dur="1.5" data-delay="1" data-on="1"/>
                    <g font-family="ui-monospace,Menlo,monospace" font-size="10" font-weight="700">
                      <rect x="14" y="130" width="60" height="26" rx="5" fill="#14303e" stroke="#7aa8ff" stroke-width="1.3"/>
                      <text x="44" y="147" text-anchor="middle" fill="#cfe0ff">JSON</text>
                      <path d="M76 143 H94" stroke="#7aa8ff" stroke-width="1.6"/>
                      {[0, 1, 2].map(i => <rect x={98 + i * 17} y="133" width="12" height="20" rx="2.5" fill="#214052" stroke="#9fb8c8" stroke-width="1" data-anim="blink" data-dur="2.1" data-delay={String(i * .7)} data-on="1"/>)}
                      <text x="156" y="147" fill="#b4cad8" font-weight="600">{p.labels[3]}</text>
                    </g>
                  </g>
                  <g class="s2" transform="translate(274 26)">
                    <rect width="220" height="172" rx="9" fill="#0e212e" stroke="#456778" stroke-width="1.3"/>
                    <path d="M0 9 Q0 0 9 0 H211 Q220 0 220 9 V24 H0 Z" fill="#163342"/>
                    <text x="12" y="16" fill="#9fc4d4" font-size="8.5" font-weight="700" font-family="ui-monospace,Menlo,monospace">SYNC · DIFF</text>
                    <g fill="#091623" stroke="#456778"><rect x="14" y="42" width="84" height="50" rx="5"/><rect x="122" y="42" width="84" height="50" rx="5"/></g>
                    <g fill="#234356">{[52, 65, 78].flatMap(y => [<rect x="22" y={y} width="64" height="6" rx="2"/>, <rect x="130" y={y} width="58" height="6" rx="2"/>])}</g>
                    <g font-family="ui-monospace,Menlo,monospace" font-size="9" font-weight="700"><text x="18" y="38" fill="#7ce0d2">A</text><text x="126" y="38" fill="#9fb8c8">B</text></g>
                    <path d="M98 67 H122" stroke="#ff7a6e" stroke-width="1.6"/>
                    <g transform="translate(110 67)" data-anim="blink" data-dur="1.1" data-on="2">
                      <circle r="8.5" fill="#32171a" stroke="#ff7a6e" stroke-width="1.6"/>
                      <path d="M-3-3L3 3M3-3L-3 3" stroke="#ff7a6e" stroke-width="1.8" stroke-linecap="round"/>
                    </g>
                    <g font-family="ui-monospace,Menlo,monospace" font-size="11.5" font-weight="700">
                      {[['+', '#7ce0d2', 150], ['−', '#ff7a6e', 118], ['~', '#ffcc8e', 136]].map(([m, c, w], i) => (
                        <g>
                          <text x="16" y={118 + i * 20} fill={c}>{m}</text>
                          <path d={`M34 ${113.5 + i * 20} H${34 + Number(w)}`} stroke={c} stroke-width="7" stroke-linecap="round" opacity=".82" data-anim="draw" data-dur=".9" data-delay={String(i * .5)} data-on="2"/>
                        </g>
                      ))}
                    </g>
                  </g>
                  <g class="s3" font-family="ui-monospace,Menlo,monospace" font-size="11" font-weight="700" text-anchor="middle">
                    {[
                      [134, '#7ce0d2', '#d8f7f2', 0, p.labels[0]],
                      [260, '#ffcc8e', '#ffe3c0', 0.5, p.labels[1]],
                      [386, '#7aa8ff', '#cfe0ff', 1, p.labels[2]],
                    ].map(([cx, stroke, ink, delay, label]) => (
                      <g>
                        <g transform={`translate(${cx} 228)`}>
                          <rect x="-54" y="-15" width="108" height="30" rx="15" fill="none" stroke={String(stroke)} stroke-width="2" data-anim="pulse" data-dur="1.5" data-delay={String(delay)} data-on="3"/>
                        </g>
                        <rect x={Number(cx) - 54} y="213" width="108" height="30" rx="15" fill="#12303a" stroke={String(stroke)} stroke-width="1.4"/>
                        <text x={cx} y="232" fill={String(ink)}>{label}</text>
                      </g>
                    ))}
                  </g>
                </svg>
              )}
              <figcaption>{p.caption}</figcaption>
            </figure>
            <ol class="pb-notes">{p.steps.map(([label, note], i) => <li data-note={i + 1}><b>{label}</b> {note}</li>)}</ol>
          </div>
          {p.facts.length > 0 && <ul class="pb-facts">{p.facts.map(f => <li>{f}</li>)}</ul>}
          <div class="pb-foot">
            <p class="pb-stack"><b>{t('Built with', '技术栈')}</b>{p.stack.join(' · ')}</p>
            {p.links.length > 0 && <div class="pb-links">{p.links.map(l => <a href={l.href}>{l.label}</a>)}</div>}
          </div>
          <details class="play" data-game={p.id} id={p.id + '-game'}>
            <summary><span class="play-icon" aria-hidden="true">▶</span><span><b>{t('Play: ', '试玩：')}{p.game.title}</b><small>{p.game.goal}</small></span></summary>
            <div class="play-body"></div>
          </details>
        </article>
      ))}
    </div>
  </div>
</div>

<script>
  import '../lib/projectBrowser';
  import '../lib/projectArt';
  import '../lib/gamesClient';
</script>

<style is:global>
