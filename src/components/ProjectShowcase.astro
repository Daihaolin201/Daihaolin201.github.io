---
import { CATEGORIES, TAGS, PROJECTS, type CategoryId, type TagId } from '../data/projects';
import { projectContent } from '../data/projectContent';

interface Props { lang: 'en' | 'zh' }
const { lang } = Astro.props;
const zh = lang === 'zh';
const t = (en: string, cn: string) => (zh ? cn : en);
const content = projectContent(lang);
const cats = Object.fromEntries(Object.entries(CATEGORIES).map(([k, v]) => [k, t(v.en, v.zh)])) as Record<CategoryId, string>;
const tagName = (id: TagId) => t(TAGS[id].en, TAGS[id].zh);
// Order: featured first, then the order of src/data/projects.ts. Category, tags and the featured flag come from there only.
const projects = PROJECTS.map(m => ({ ...content.find(c => c.id === m.id)!, ...m, why: m.featured && t(m.featured.en, m.featured.zh) }))
  .sort((a, b) => Number(!!b.featured) - Number(!!a.featured));
const count = (c: CategoryId) => projects.filter(p => p.cat === c).length;
const tagCount = (id: TagId) => projects.filter(p => p.tags.includes(id)).length;
const usedTags = (Object.keys(TAGS) as TagId[]).filter(id => tagCount(id) > 0);
---
<div class="pb" data-pb>
  <div class="pb-filters" role="group" aria-label={t('Filter projects', '筛选项目')}>
    <button type="button" class="pb-filter" data-filter="all" aria-pressed="true">{t('All', '全部')} <span>{projects.length}</span></button>
    {(Object.keys(cats) as CategoryId[]).map(c => <button type="button" class="pb-filter" data-filter={c} aria-pressed="false">{cats[c]} <span>{count(c)}</span></button>)}
  </div>
  <div class="pb-filters pb-tagfilters" role="group" aria-label={t('Filter by topic', '按主题筛选')}>
    <span class="pb-filters-label">{t('Topic', '主题')}</span>
    <button type="button" class="pb-filter" data-tag-filter="all" aria-pressed="true">{t('Any', '不限')}</button>
    {usedTags.map(id => <button type="button" class="pb-filter" data-tag-filter={id} aria-pressed="false">{tagName(id)} <span>{tagCount(id)}</span></button>)}
  </div>
  <p class="pb-empty" hidden>{t('No project has both. Change the category or the topic.', '没有同时符合的项目，请换一个分类或主题。')}</p>
  <div class="pb-body">
    <ol class="pb-list">
      {projects.map(p => (
        <li data-cat={p.cat} data-tags={p.tags.join(' ')}>
          <a class="pb-item" href={'#' + p.id} data-pb-item={p.id}>
            <span class="pb-item-title">{p.title}</span>
            <span class="pb-item-meta">{p.featured && <span class="lbl featured">{t('Featured', '精选')}</span>}{p.award && <span class="lbl award">{p.award}</span>}</span>
            <span class="pb-item-tags">{p.tags.map(id => <span class="pb-tag">{tagName(id)}</span>)}</span>
          </a>
        </li>
      ))}
    </ol>
    <div class="pb-panels">
      {projects.map(p => (
        <article class="pb-panel" id={p.id} data-cat={p.cat} aria-labelledby={p.id + '-title'}>
          <header class="pb-head">
            <div class="lbls"><span class={'lbl cat-' + p.cat}>{cats[p.cat]}</span>{p.featured && <span class="lbl featured">{t('Featured', '精选')}</span>}{p.award && <span class="lbl award">{p.award}</span>}{p.role && <span class="lbl role">{p.role}</span>}</div>
            <h3 id={p.id + '-title'}>{p.title}</h3>
            <ul class="pb-tags" aria-label={t('Topics', '主题')}>{p.tags.map(id => <li>{tagName(id)}</li>)}</ul>
            {p.why && <p class="pb-why"><b>{t('Featured: ', '精选：')}</b>{p.why}</p>}
            <p class="pb-context">{p.context}<time>{p.date}</time></p>
            <p class="pb-blurb">{p.blurb}</p>
            {p.part && <p class="pb-part"><b>{t('My part', '负责')}</b>{p.part}</p>}
            <p class="pb-jump"><a href={'#' + p.id + '-game'} data-open-game={p.id}><span aria-hidden="true">▶</span>{t('Jump to the game', '直接试玩')}<small>{p.game.title}</small></a></p>
          </header>
          <div class="pb-explain">
            <div class="pb-steps" role="group" aria-label={t('How it works, step by step', '分步看它怎么工作')}>
              {p.steps.map(([label], i) => <button type="button" class="pb-step" data-step={i + 1} aria-pressed={i === 0 ? 'true' : 'false'}><b>{i + 1}</b>{label}</button>)}
            </div>
