---
import ToolPage from './ToolPage.astro';
import english from '../data/en.json';
import { publicEmail } from '../data/publicLinks';
import { personSchema, jsonLd } from '../data/profile';
import type { Language } from '../data/siteTools';

interface Props { lang: Language }
const { lang } = Astro.props;
const zh = lang === 'zh';
const tx = (en: string, cn: string) => (zh ? cn : en);

const title = tx('Official Identity & Homonym Disambiguation', '官方身份核验与同名区分声明');
const description = tx(
  'Canonical channels, academic affiliation, and homonym disambiguation for Donglin (Dennis) Li (Department of EEE, The University of Manchester).',
  '李栋林（Donglin / Dennis Li，曼彻斯特大学电气与电子工程系）的官方渠道白名单、学术归属说明与同名区分声明。'
);
const pageUrl = new URL(zh ? '/zh/verify/' : '/verify/', Astro.site);
const structured = jsonLd({
  '@type': 'ProfilePage',
  url: pageUrl.href,
  inLanguage: zh ? 'zh-CN' : 'en',
  name: title,
  mainEntity: personSchema(Astro.site, lang, english.contact.profiles),
});

const verifiedLinks = [
  { label: tx('Official Website (EN)', '官方英文主页'), display: 'https://donglinli.com/', href: 'https://donglinli.com/' },
  { label: tx('Official Website (ZH)', '官方中文主页'), display: 'https://donglinli.com/zh/', href: 'https://donglinli.com/zh/' },
  { label: tx('Official Public Email', '官方公开邮箱'), display: publicEmail, href: `mailto:${publicEmail}` },
  { label: tx('PGR Feedback Portal (UoM EEE)', '曼大 EEE 博士生意见箱'), display: 'https://pgr.donglinli.com/', href: 'https://pgr.donglinli.com/' },
  { label: 'GitHub', display: 'https://github.com/Daihaolin201', href: 'https://github.com/Daihaolin201' },
  { label: 'ORCID', display: 'https://orcid.org/0009-0007-2130-4862', href: 'https://orcid.org/0009-0007-2130-4862' },
  { label: tx('Google Scholar', '谷歌学术'), display: 'https://scholar.google.com/citations?user=mBr54wEAAAAJ', href: 'https://scholar.google.com/citations?user=mBr54wEAAAAJ' },
  { label: 'LinkedIn', display: 'https://www.linkedin.com/in/donglin-li-55424326b', href: 'https://www.linkedin.com/in/donglin-li-55424326b' },
];
---
<ToolPage tool="verify" lang={lang} title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={structured} />
  <div class="verify-grid">
    <section class="form-panel" aria-labelledby="v-identity">
      <h2 id="v-identity">{tx('Canonical Identity', '标准身份信息')}</h2>
      <dl class="v-dl">
        <dt>{tx('Full Name', '姓名')}</dt>
        <dd>Donglin Li (Dennis Li) / 李栋林</dd>
        <dt>{tx('Role & Affiliation', '职务与归属')}</dt>
        <dd>{tx(
          'PhD Researcher (2024–present), Department of Electrical and Electronic Engineering, The University of Manchester, UK (BEng Hons., First Class, 2021–2024).',
          '博士研究生（2024–至今），英国曼彻斯特大学电气与电子工程系（一等荣誉工学学士，2021–2024）。'
        )}</dd>
        <dt>{tx('Research Focus', '研究方向')}</dt>
        <dd>{tx(
          'Bayesian Dual Control · Cooperative Multi-Robot Source Seeking · Distributed & LLM Serving Control.',
          '贝叶斯对偶控制 · 多机器人协同寻源 · 分布式控制与大语言模型推理服务调度。'
        )}</dd>
      </dl>
      <div class="v-cta">
        <a class="v-btn primary" href={zh ? '/zh/' : '/'}>{tx('Back to Main Site (donglinli.com)', '返回个人主页 (donglinli.com)')}</a>
        <a class="v-btn" href={zh ? '/zh/cv/' : '/cv/'}>{tx('Academic CV', '学术简历')}</a>
      </div>
    </section>

    <section class="form-panel" aria-labelledby="v-channels">
      <h2 id="v-channels">{tx('Verified Official Channels', '官方认证渠道白名单')}</h2>
      <p class="v-note">{tx(
        'Only the domains, email address, and profiles listed below are officially operated by Donglin (Dennis) Li:',
        '以下域名、邮箱及学术/技术档案为本人唯一官方核验渠道（均标有 rel="me" 互认链接）：'
      )}</p>
      <ul class="v-links">
        {verifiedLinks.map(item => (
          <li>
            <span class="v-k">{item.label}</span>
            <a rel="me" href={item.href}>{item.display}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="form-panel v-wide" aria-labelledby="v-homonyms">
      <h2 id="v-homonyms">{tx('Homonym Disambiguation (同名区分声明)', '同名区分声明 (Homonym Disambiguation)')}</h2>
      <p class="v-note">{tx(
        '“Donglin Li” and “李栋林” are shared by several unrelated researchers and public figures. Donglin (Dennis) Li at The University of Manchester is NOT affiliated with any of the following:',
        '中英文姓名“李栋林 / Donglin Li”存在多位与本人无关的同名学者与公众人物。曼彻斯特大学电气与电子工程系的李栋林（Donglin / Dennis Li）与以下人员或机构均无关联：'
      )}</p>
      <ul class="v-bullets">
        <li>{tx(
          'NOT the Fermilab Muon g-2 Collaboration physicist Donglin Li (affiliated with Shanghai Jiao Tong University / Shenzhen Technology University; Phys. Rev. D 110, 032009, 2024).',
          '非费米实验室 Muon g-2 合作组物理学者 Donglin Li（上海交通大学 / 深圳技术大学，Phys. Rev. D 110, 032009, 2024）。'
        )}</li>
        <li>{tx(
          'NOT researchers named Donglin Li / Dong-Lin Li at National Taiwan Ocean University (NTOU), Stanford University (Materials Science), Shenyang University of Technology, Chang’an University, or NIMS Japan.',
          '非台湾海洋大学（NTOU）、斯坦福大学材料科学系、沈阳工业大学、长安大学或日本 NIMS 的同名学者 Donglin Li / Dong-Lin Li。'
        )}</li>
        <li>{tx(
          'NOT vascular surgeon 李栋林 (First Affiliated Hospital, Zhejiang University School of Medicine), NOT Beijing media executive 李栋林, and NOT individuals appearing in unrelated municipal public notices.',
          '非浙江大学医学院附属第一医院血管外科主任医师李栋林、非北京文化传媒界同名高管，亦非各地政务公示名单中的同名居民。'
        )}</li>
        <li>{tx(
          'Collaborative publications: joint papers with co-authors at Southeast University (seu.edu.cn) reflect inter-institutional research collaboration; primary enrolment, degree, and affiliation are solely at The University of Manchester.',
          '合作论文说明：与东南大学（seu.edu.cn）合作者共同发表的论文属跨校科研合作成果；本人唯一主学籍、学位与任职归属单位为英国曼彻斯特大学。'
        )}</li>
      </ul>
    </section>

    <section class="form-panel v-wide" aria-labelledby="v-anti">
      <h2 id="v-anti">{tx('Anti-Impersonation Policy', '防冒名与非官方账号声明')}</h2>
      <p>{tx(
        'No X (Twitter), WeChat, Telegram, Zhihu, CSDN, or Bilibili account is official unless explicitly listed on this page and on donglinli.com. Please verify correspondence via hello@donglinli.com.',
        '除非在本页及 donglinli.com 明确列出，本人未在 X（Twitter）、微信公众平台、Telegram、知乎、CSDN 或 B 站运营任何官方个人账号。如遇同名或疑似冒名联系，请通过 hello@donglinli.com 核实。'
      )}</p>
    </section>
  </div>
</ToolPage>

<style>
  .verify-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; align-items: start; }
  .verify-grid h2 { margin: 0 0 12px; font: 600 1.2rem/1.3 var(--serif); color: var(--text); }
  .v-wide { grid-column: 1 / -1; }
  .v-dl { margin: 0; display: grid; gap: 10px; }
  .v-dl dt { font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--faint); }
  .v-dl dd { margin: 0; color: var(--text); line-height: 1.55; }
  .v-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .v-btn { display: inline-flex; align-items: center; min-height: 42px; padding: 0 16px; border-radius: 10px; border: 1px solid var(--edge-strong); background: var(--sunk); color: var(--text); font-weight: 600; font-size: .9rem; text-decoration: none; }
  .v-btn:hover { border-color: var(--accent); }
  .v-btn.primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .v-note { margin: 0 0 12px; color: var(--muted); font-size: .94rem; line-height: 1.6; }
  .v-links { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .v-links li { display: grid; gap: 2px; padding: 8px 11px; border-radius: 10px; border: 1px solid var(--edge); background: var(--sunk); }
  .v-k { font-size: .78rem; color: var(--faint); font-weight: 600; }
  .v-links a { font-family: var(--mono); font-size: .85rem; overflow-wrap: anywhere; }
  .v-bullets { margin: 0; padding-left: 1.2rem; display: grid; gap: 10px; color: var(--text); line-height: 1.6; }
  .v-wide p:last-child { margin: 0; color: var(--muted); line-height: 1.65; }
  @media (max-width: 820px) { .verify-grid { grid-template-columns: 1fr; } }
</style>
