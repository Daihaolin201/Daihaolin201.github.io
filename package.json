{
  "name": "donglin-li-homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:uom": "node scripts/build-uom.mjs",
